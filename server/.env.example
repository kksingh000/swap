# MongoDB Atlas connection string. Leave unset in dev to use an in-memory
# MongoDB (auto-seeded, wiped on restart).
MONGODB_URI=

# Secret used to sign JWTs — set a long random string in production.
JWT_SECRET=change-me-in-production

# Comma-separated list of allowed CORS origins.
CORS_ORIGINS=http://localhost:5173,https://swap-atelier.vercel.app

PORT=5000
